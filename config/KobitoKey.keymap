#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_eisu {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp LANG2>;
        };

        combo_kana {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp LANG1>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&kp TAB>;
        };
    };

    macros {
        num_eisu: num_eisu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2 &to 2>;
            label = "NUM_EISU";
        };

        re_to_L0: re_to_L0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LANG1>;
            label = "RE_TO_L0";
        };

        zenkaku_kagi: eisu_kagi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG1 &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp ENTER &kp LEFT_ARROW>;
            label = "EISU_KAGI";
        };

        hankaku_kakko: han_kakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2 &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT_ARROW &kp LANG1>;
            label = "HAN_KAKKO";
        };
    };

    behaviors {
        hold_kp: hold_kp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E      &kp R        &kp T         &kp Y     &kp U          &kp I            &kp O      &kp P
&kp A             &kp S         &kp D      &kp F        &kp G         &kp H     &kp J          &kp K            &kp L      &kp ENTER
&mt LEFT_SHIFT Z  &kp X         &kp C      &kp V        &kp B         &kp N     &kp M          &kp COMMA        &kp DOT    &mt RIGHT_SHIFT MINUS
&kp LEFT_ALT      &kp QUESTION  &lt 2 TAB  &lt 1 SPACE  &kp LEFT_GUI  &kp BSPC  &lt 2 AT_SIGN  &kp EXCLAMATION  &lt 4 DEL  &kp LEFT_CONTROL
            >;
        };

        layer1 {
            label = "ARROW";
            bindings = <
&kp ESCAPE  &trans          &kp UP_ARROW    &hankaku_kakko   &zenkaku_kagi         &kp MINUS  &trans     &kp UP    &trans     &trans
&mkp MB4    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &mkp MB5              &kp PLUS   &kp LEFT   &kp DOWN  &kp RIGHT  &trans
&trans      &trans          &trans          &trans           &kp RS(RG(NUMBER_4))  &kp ASTRK  &kp SLASH  &kp LBKT  &kp RBKT   &trans
&trans      &trans          &trans          &trans           &trans                &trans     &trans     &trans    &trans     &trans
            >;
        };

        layer2 {
            label = "NUMBER";
            bindings = <
&trans  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp PIPE     &kp DOLLAR     &kp SLASH      &kp N7        &kp N8        &kp N9        &kp ASTRK
&trans  &trans            &kp COLON          &kp AT_SIGN  &kp AMPERSAND  &kp HASH       &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp ENTER
&trans  &trans            &kp SEMI           &trans       &kp PERCENT    &kp PERIOD     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PLUS
&trans  &trans            &trans             &trans       &trans         &kp BACKSPACE  &trans        &kp N0        &kp MINUS     &kp EQUAL
            >;
        };

        layer3 {
            label = "MOUSE";
            bindings = <
&trans     &trans        &trans  &trans    &trans  &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans
&trans     &trans        &trans  &mkp MB1  &trans  &trans  &trans    &trans    &trans    &trans
&trans     &trans        &trans  &trans    &trans  &trans  &trans    &trans    &trans    &trans
&kp LSHFT  &kp LEFT_ALT  &trans  &trans    &trans  &trans  &trans    &trans    &to 0     &kp RALT
            >;
        };

        layer_4 {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &bt BT_CLR      &bootloader   &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
&trans        &trans        &trans        &trans        &trans          &trans        &trans        &trans        &trans        &trans
            >;

            label = "BLUETOOTH";
        };
    };
};
